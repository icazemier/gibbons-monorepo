{
  "extends": "./tsconfig-build-esm.json",
  "compilerOptions": {
    // Emits the CommonJS half of the dual build. 
    // TS 7.0 requires moduleResolution to match module format.
    // 'node16' is used here to support CommonJS output correctly.
    "module": "CommonJS",
    "moduleResolution": "node16",
    "outDir": "./build/cjs",
    "target": "ES2017"
  }
}