{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "nodenext",
    "lib": ["ESNext"],
    "target": "ESNext",
    "outDir": "./build/esm",
    "rootDir": "./src",
    "baseUrl": "./src",
    "declarationMap": false,
    "sourceMap": false
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/**/*.spec.ts", "tests/**/*", "node_modules", "build"]
}
