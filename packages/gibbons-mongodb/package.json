{
  "name": "@icazemier/gibbons-mongodb",
  "private": false,
  "version": "0.0.0",
  "type": "module",
  "description": "Gibbons is a Node.js module which helps in managing user groups and user permissions with `bitwise` efficiency.",
  "contributors": [
    {
      "name": "Ivo Cazemier",
      "email": "git@warmemelk.nl",
      "url": "https://github.com/icazemier"
    }
  ],
  "keywords": [
    "user permissions",
    "user groups",
    "bitwise",
    "MongoDB",
    "NoSQL",
    "cli"
  ],
  "files": [
    "build/"
  ],
  "bin": {
    "gibbons-mongodb": "build/esm/bin/cli.js"
  },
  "main": "./build/cjs/index.js",
  "module": "./build/esm/index.js",
  "exports": {
    ".": {
      "import": "./build/esm/index.js",
      "require": "./build/cjs/index.js"
    }
  },
  "types": "./build/esm/index.d.ts",
  "engines": {
    "node": ">=22.0.0",
    "bun": ">=1.0.0"
  },
  "os": [
    "darwin",
    "linux",
    "win32"
  ],
  "scripts": {
    "test": "cross-env NODE_ENV=test vitest run --coverage",
    "build:esm": "tsc -p tsconfig-build-esm.json",
    "build:cjs": "tsc -p tsconfig-build-cjs.json",
    "build": "rimraf build && npm run build:esm && npm run build:cjs && npm run fixup && npm run docs",
    "docs": "typedoc --out docs src/index.ts",
    "fixup": "node ../../fixup.mjs",
    "clean:build": "rimraf build",
    "clean:docs": "rimraf docs",
    "release": "semantic-release",
    "release:dry": "semantic-release --dry-run"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/icazemier/gibbons-monorepo.git",
    "directory": "packages/gibbons-mongodb"
  },
  "homepage": "https://github.com/icazemier/gibbons-monorepo/tree/main/packages/gibbons-mongodb#readme",
  "bugs": {
    "url": "https://github.com/icazemier/gibbons-monorepo/issues"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "mongodb": "^6.0.0"
  },
  "dependencies": {
    "@icazemier/gibbons": "catalog:",
    "cosmiconfig": "catalog:",
    "yargs": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/yargs": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "conventional-changelog-conventionalcommits": "catalog:",
    "cross-env": "catalog:",
    "dotenv": "catalog:",
    "mongodb": "^6.16.0",
    "mongodb-memory-server": "^11.2.0",
    "noop-stream": "catalog:",
    "npm-run-all2": "catalog:",
    "rimraf": "catalog:",
    "semantic-release": "catalog:",
    "semantic-release-monorepo": "catalog:",
    "ts-node": "catalog:",
    "typedoc": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
