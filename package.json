{
  "name": "gibbons-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "test": "pnpm run test:tools && pnpm -r run test",
    "test:tools": "node --test tools/*.spec.ts",
    "typecheck": "tsc --noEmit",
    "lint": "pnpm run typecheck && node tools/check-deno-import-map.ts && eslint .",
    "lint:fix": "node tools/check-deno-import-map.ts --fix && eslint . --fix",
    "release:dry": "pnpm -r run release:dry",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "catalog:",
    "@commitlint/config-conventional": "catalog:",
    "@eslint/js": "catalog:",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "eslint-config-prettier": "catalog:",
    "eslint-plugin-prettier": "catalog:",
    "husky": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "mongodb-memory-server",
      "embedded-postgres",
      "@embedded-postgres/darwin-arm64",
      "@embedded-postgres/linux-x64"
    ],
    "overrides": {
      "minimatch": "^10.2.6",
      "lodash": "^4.18.1",
      "lodash-es": "^4.18.1",
      "vite": "^7.3.2",
      "fast-uri": "^3.1.5",
      "follow-redirects": "^1.16.0",
      "postcss": "^8.5.23",
      "picomatch": "^4.0.5",
      "ip-address": "^10.4.0",
      "brace-expansion": "^5.0.9",
      "js-yaml": "^4.3.0",
      "shell-quote": "^1.10.0",
      "linkify-it": "^5.0.2",
      "esbuild": "^0.28.1",
      "undici@6": "^6.28.0",
      "undici@7": "^7.29.0"
    }
  }
}
