{
  "name": "gibbons-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "test": "pnpm -r run test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "release:dry": "pnpm -r run release:dry",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "catalog:",
    "@commitlint/config-conventional": "catalog:",
    "@eslint/js": "catalog:",
    "eslint": "catalog:",
    "eslint-config-prettier": "catalog:",
    "eslint-plugin-prettier": "catalog:",
    "husky": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "mongodb-memory-server",
      "embedded-postgres",
      "@embedded-postgres/darwin-arm64",
      "@embedded-postgres/linux-x64"
    ],
    "overrides": {
      "minimatch": "^10.2.4",
      "lodash": "^4.18.1",
      "lodash-es": "^4.18.1",
      "vite": "^7.3.2",
      "fast-uri": "^3.1.2",
      "follow-redirects": "^1.16.0",
      "postcss": "^8.5.14",
      "picomatch": "^4.0.4",
      "ip-address": "^10.2.0",
      "brace-expansion": "^5.0.6"
    }
  }
